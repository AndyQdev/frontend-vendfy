{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "El panel de Vendfy (remoto) puede escuchar los eventos de la app y pedirle que traiga la ventana al frente",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://app.vendfy.shop/*",
      "https://vendfy-panel.vercel.app/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-traer-al-frente",
    "allow-info-escritorio"
  ]
}
