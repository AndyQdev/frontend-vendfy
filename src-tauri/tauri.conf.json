{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vendfy",
  "version": "0.1.0",
  "identifier": "shop.vendfy.escritorio",
  "build": {
    "frontendDist": "https://vendfy-panel.vercel.app",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Vendfy",
    "shortDescription": "Vendfy: vende, cobra y maneja tu tienda hablando",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"]
      }
    }
  }
}
